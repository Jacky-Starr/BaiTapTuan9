<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. Appender xuất log ra màn hình Console -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Appender ghi log ra file vật lý và xoay vòng theo ngày -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/math-utils.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Tự động lưu trữ file log cũ theo từng ngày -->
            <fileNamePattern>logs/math-utils.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Giữ lại log tối đa 30 ngày -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Áp dụng cả 2 Appender cho toàn bộ ứng dụng ở mức INFO trở lên -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

</configuration>